{
  "name": "koers-engineering",
  "version": "1.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Canary-PrintDesign/koers-engineering.git"
  },
  "author": "Koers & Associates Engineering LTD.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.18.0",
    "npm": ">=10"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build:dirs": "mkdir -p dist/assets/js dist/assets/css",
    "build:jekyll": "bundle exec jekyll build --config src/_config.yml,src/_config-common.yml,src/_config-production.yml --source src/ --destination dist/",
    "build:jekyll:dev": "bundle exec jekyll build --drafts --watch --config src/_config.yml,src/_config-common.yml,src/_config-development.yml --source src/ --destination dist/",
    "build:css": "sass --load-path=src/assets/css src/assets/css/main.scss dist/assets/css/main.css",
    "build:js": "babel src/assets/js --out-file dist/assets/js/app.js",
    "watch:css": "sass --watch --load-path=src/assets/css --embed-source-map src/assets/css/main.scss:dist/assets/css/main.css",
    "watch:js": "babel src/assets/js --watch --out-file dist/assets/js/app.js --source-maps inline",
    "serve": "browser-sync start --server dist --files dist",
    "build": "npm run clean && npm run build:dirs && npm run build:jekyll && npm run build:css && npm run build:js",
    "dev": "./dev.sh"
  },
  "babel": {
    "presets": [
      [
        "@babel/preset-env",
        {
          "targets": "defaults"
        }
      ]
    ]
  },
  "devDependencies": {
    "@babel/cli": "^8.0.1",
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "browser-sync": "^3.0.4",
    "sass": "^1.101.0"
  }
}
